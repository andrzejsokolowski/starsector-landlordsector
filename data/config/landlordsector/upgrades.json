{
	# Home upgrades (0.4.0). Two kinds for now:
	#   furniture: a cargo item (special_items.csv row "lls_<id>", tag lls_furniture). You place it in a home and
	#     can take it back. It uses the home's furniture slots ("slots" in tiers.json).
	#   renovation: built with credits from the Manage page. It takes "days" to build and stays with the home.
	#     It uses renovation slots (renovationSlots below). cost: share of the home's full value, at least minCost.
	#
	# Effects, the same words house traits use (house_traits.json):
	#   comfort, decor, happiness, health, security (added), price, wear (multiplied)
	#   levels: home levels it changes, {"heat":-1} cooler, {"air":1} cleaner air (levels.json)
	#   kids: effects only for tenants with kids ("Family with kids"), {"happiness":4}
	#   events: multiplies the chance of tenant events (tenant_events.json), {"small_fire":0.5}
	#   tags: what tenants can like or hate (tenant_traits.json)
	#   cancels: market conditions it takes off this one home, with the hazard each adds
	# Where it can go: minTier, maxTier (0 shack to 5 estate), station (true stations only, false planets only),
	#   needs (house traits: only homes with one of them).
	# fixes: house traits the renovation removes when it is done. oneTime: the renovation is a job, not a part of
	#   the home: it takes no slot and is gone once done.
	# roll: renovations a home for sale may already have, like house traits: weight, anyCondition, climates.
	"renovationSlots":{"shack":1, "studio":1, "small_house":2, "house":2, "villa":3, "estate":4},
	# Chance a home for sale comes with one renovation already done.
	"listingChance":0.3,
	# Furniture pieces each market with a property agent stocks in its open market, and how often it restocks.
	"shopStock":[1, 3],
	"shopDays":30,
	# Chance that salvage or battle loot holds one piece of furniture.
	"lootChance":0.12,
	"upgrades":[
