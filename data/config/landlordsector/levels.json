{
	# Home levels: how hot, cold or irradiated one home is, from 0 (fine) to 3. 0.5.0: air and noise moved to the
	# Environment grades (environment.json), and light is gone.
	# words: what each level is called, 0 to 3. "Heat: Hot (1)".
	# better: true when a plus is good for this level. House traits and upgrades write their changes as
	#   "levels":{"heat":-1} (cooler) or {"radiation":-2} (shielded).
	# conditions: market conditions and the level each adds. industries: the same for buildings on the market.
	# All added up, at most 3.
	# happiness, health: what each level costs a tenant per step. Tenant traits can multiply them
	#   ("levels" in tenant_traits.json), and "healthCost" multiplies every health cost.
	"levels":[
		{"id":"heat", "name":"Heat", "words":["None", "Hot", "Very hot", "Scorching"], "happiness":-3, "health":-3,
			"conditions":{"hot":1, "very_hot":2}},
		{"id":"cold", "name":"Cold", "words":["None", "Cold", "Very cold", "Freezing"], "happiness":-3, "health":-3,
			"conditions":{"cold":1, "very_cold":2}},
		{"id":"radiation", "name":"Radiation", "words":["None", "Low", "High", "Deadly"], "happiness":-2, "health":-8,
			"conditions":{"irradiated":2, "no_atmosphere":1, "bbplus_sigmairradiated":2}}
	],
	# Health. Every tenant starts at baseHealth, then home levels, the environment, a worn home, traits and upgrades
	# move it. Below sickBelow they can fall sick and miss rent more often. Below treatmentBelow they may move out to
	# get treatment. wornHealth: health lost in a home at 0% condition (half of it at 25%, none from 50% up).
	"baseHealth":70,
	"sickBelow":60,
	"treatmentBelow":20,
	"wornHealth":20
}
