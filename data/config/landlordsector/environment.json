{
	# Environment (0.5.0): what one home's surroundings are like, each a score from 0 to 100, shown as a letter
	# grade (S 90+, A 75+, B 60+, C 45+, D 30+, E 15+, F below). Higher is always better: a high Noise grade is a
	# quiet home.
	# base: the score before anything else. station: added on stations. conditions: added for each market
	# condition the market has. Neighbours, house traits and upgrades add their own ("env" in house_traits.json
	# and upgrades.json).
	# neutral, happiness, health: every point above neutral adds this much tenant happiness and health, every point
	# below takes it away. Tenant traits can multiply that ("levels" in tenant_traits.json, same ids).
	# better, worse: how a change reads in tooltips ("Quieter (+15)").
	"scores":[
		{"id":"commute", "name":"Commute", "better":"Shorter commute", "worse":"Longer commute",
			"base":50, "station":10, "neutral":50, "happiness":0.15, "health":0},
		{"id":"air", "name":"Air", "better":"Cleaner air", "worse":"Dirtier air",
			"base":80, "station":-10, "neutral":70, "happiness":0.05, "health":0.25,
			"conditions":{"pollution":-30, "toxic_atmosphere":-35, "no_atmosphere":-10, "thin_atmosphere":-5,
				"dense_atmosphere":-10, "extreme_weather":-5, "inimical_biosphere":-10}},
		{"id":"noise", "name":"Noise", "better":"Quieter", "worse":"Louder",
			"base":80, "station":-5, "neutral":70, "happiness":0.2, "health":0.05,
			"conditions":{"extreme_weather":-5, "extreme_tectonic_activity":-10, "tectonic_activity":-5}}
	],

	# Neighbours: each home sits next to one building on its colony, or next to nothing. A home for sale rolls one
	# from the buildings the colony has, each with its weight, against nothingWeight. If the building is gone later,
	# the home counts as next to nothing.
	# Each neighbour: commute, air, noise (added to the scores), price (multiplies the location), happiness,
	# health, security (added), tags (what tenants like or hate, tenant_traits.json), weight (how often it is
	# rolled), name (shown instead of the building's own name).
	# byId: buildings by industry id. byTag: buildings by their industries.csv tag, first match wins, for every
	# building not in byId. skipIds, skipTags: never rolled (orbital stations, hidden buildings).
	"nothingWeight":3,
	"skipTags":["station", "battlestation", "starfortress", "sub_item", "hide_in_codex", "do_not_show_in_build_dialog", "artillery"],
	"skipIds":["grounddefenses", "planetaryshield", "IndEvo_InvisiblePlanetaryShield", "istl_sigmafield", "aotd_gw_construction_site", "aotd_misc_hidden_industry", "dummy_industry", "MPC_FOBIAIICPatherResist"],
